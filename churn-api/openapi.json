            "minItems": 1,
            "title": "Customers",
            "type": "array"
          }
        },
        "required": [
          "customers"
        ],
        "title": "BatchRequest",
        "type": "object"
      },
      "BatchResponse": {
        "properties": {
          "count": {
            "title": "Count",
            "type": "integer"
          },
          "model_version": {
            "title": "Model Version",
            "type": "string"
          },
          "predictions": {
            "items": {
              "$ref": "#/components/schemas/Prediction"
            },
            "title": "Predictions",
            "type": "array"
          }
        },
        "required": [
          "predictions",
          "count",
          "model_version"
        ],
        "title": "BatchResponse",
        "type": "object"
      },
      "Customer": {
