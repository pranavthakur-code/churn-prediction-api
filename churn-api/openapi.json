        },
        "security": [
          {
            "APIKeyHeader": []
          }
        ],
        "summary": "Which model is serving, and how it was trained",
        "tags": [
          "ops"
        ]
      }
    },
    "/predict": {
      "post": {
        "operationId": "predict_predict_post",
        "requestBody": {
