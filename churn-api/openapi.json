    "securitySchemes": {
      "APIKeyHeader": {
        "description": "API key issued to the calling system",
        "in": "header",
        "name": "X-API-Key",
        "type": "apiKey"
      }
    }
  },
  "info": {
    "description": "\nScores telecom customers for churn risk so the CRM can act in real time.\n\n* Every request except `/health` needs an `X-API-Key` header.\n* `churn_predicted` compares the probability with a **cost-based threshold**\n  (see the model card), not a default 0.5.\n* Unknown category labels are accepted and flagged in `warnings`; malformed\n  values (wrong type, out of range, missing or unexpected fields) get a `422`\n  that names each offending field.\n",
    "title": "Churn Prediction API",
    "version": "1.0.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/drift": {
      "post": {
        "operationId": "drift_drift_post",
        "parameters": [
          {
            "in": "query",
            "name": "psi_threshold",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "number"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Psi Threshold"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/BatchRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DriftResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Missing or invalid API key"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Invalid request body"
          }
        },
        "security": [
          {
            "APIKeyHeader": []
          }
        ],
        "summary": "Population Stability Index of recent inputs vs training data",
        "tags": [
          "monitoring"
        ]
      }
    },
    "/health": {
      "get": {
