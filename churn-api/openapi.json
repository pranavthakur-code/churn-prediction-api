                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Invalid request body"
          }
        },
        "security": [
          {
            "APIKeyHeader": []
          }
        ],
        "summary": "Score up to CHURN_MAX_BATCH customers",
        "tags": [
          "prediction"
        ]
      }
    }
  }
}
